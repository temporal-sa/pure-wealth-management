# Temporal Cloud connection for the cloud scripts (startcloudworker.sh, startcloudapi.sh,
# cloudsendcomplianceapproval.sh). Copy this file to setcloudenv.sh in the repository root
# and fill in your namespace. setcloudenv.sh is ignored by git.
#
# Use either mTLS (a client certificate and key) or an API key.

export TEMPORAL_NAMESPACE=<namespace>.<accountID>

# mTLS
export TEMPORAL_ADDRESS=<namespace>.<accountID>.tmprl.cloud:7233
export TEMPORAL_TLS_CLIENT_CERT_PATH="/path/to/client.pem"
export TEMPORAL_TLS_CLIENT_KEY_PATH="/path/to/client.key"

# API key: comment out the three mTLS lines above and use these instead.
# The address is the namespace's regional endpoint, shown in the Temporal Cloud UI.
# export TEMPORAL_ADDRESS=<region>.<cloud provider>.api.temporal.io:7233
# export TEMPORAL_API_KEY=<API key>
